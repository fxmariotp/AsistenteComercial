# ============================================================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO (SIN SECRETOS) - ASISTENTE COMERCIAL
# Archivo: .env.example
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SUPABASE (Base de datos y Autenticación GoTrue)
# ----------------------------------------------------------------------------
# URL base de tu proyecto Supabase (en producción, staging o local)
SUPABASE_URL=https://tu-proyecto-staging.supabase.co

# Clave pública anónima (safe para frontend / cliente)
SUPABASE_ANON_KEY=sb_publishable_ejemplo_clave_anonima_staging

# Clave de Servicio Administrativa (Service Role - SOLO en backend / Vercel Serverless)
# NUNCA exponer en HTML, JavaScript de cliente ni commits públicos
SUPABASE_SERVICE_ROLE_KEY=sb_secret_ejemplo_clave_service_role_staging

# ----------------------------------------------------------------------------
# 2. GOOGLE SHEETS API (Comisiones Servidor a Servidor mediante Service Account)
# ----------------------------------------------------------------------------
# Correo de la cuenta de servicio creada en Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=asistente-sync@tu-proyecto-gcp.iam.gserviceaccount.com

# Clave privada RSA PEM de la cuenta de servicio (con saltos de línea \n escapados)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Identificador de la hoja de Google Sheets (menú Compartir -> modo restringido a la Service Account)
GOOGLE_SHEET_ID=tu_google_sheet_id_staging

# ----------------------------------------------------------------------------
# 3. GOOGLE APPS SCRIPT (Origen privado del Ranking Comercial)
# ----------------------------------------------------------------------------
# URL del despliegue de Apps Script como aplicación web (Web App)
RANKING_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec

# Secreto compartido de validación en doPost(e) (Servidor a Servidor sin exponer en URL)
RANKING_SHARED_SECRET=clave_secreta_webhook_staging_64_caracteres_aleatorios

# ----------------------------------------------------------------------------
# 4. CONFIGURACIÓN DEL SERVIDOR
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
